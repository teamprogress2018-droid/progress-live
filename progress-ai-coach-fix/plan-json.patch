+const v3parsed = v3.parseAIJson('{"planTitle":"V3","philosophy":"opis "wewnątrz"","sessions":[]}');
+ok('v3 inner quotes', v3parsed.planTitle === 'V3' && v3parsed.philosophy.includes('wewnątrz'));
+
+const indexSrc = fs.readFileSync(path.join(__dirname, 'index.html'), 'utf8');
+ok('index asks only w1', /Podaj wartości TYLKO dla tygodnia 1/.test(indexSrc));
+ok('index no empty-weeks throw', !/Pusta odpowiedź dla tygodni/.test(indexSrc));
