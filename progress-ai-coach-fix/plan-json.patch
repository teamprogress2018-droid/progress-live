+function computeExerciseProgression(ex, weekKeys, phasesMap, progressionType) {
+  const base = ex.w1 || {};
+  const baseS = base.s != null ? base.s : (ex.sets || 3);
+  const baseR = base.r != null ? base.r : (ex.reps || '10');
+  const baseRest = base.rest || ex.rest || '90s';
+  const baseRpe = parseFloat(base.rpe || ex.rpe) || 7;
+  let baseKgNum = null, kgSuffix = '', skipKg = false;
+  const kgStr = String(base.kg || '');
+  if (kgStr) {
+    const m = kgStr.match(/^(\d+(?:\.\d+)?)(.*)$/);
+    if (m) {
+      baseKgNum = parseFloat(m[1]);
+      kgSuffix = m[2] || '';
+      skipKg = /HR|min|:|–|—/.test(kgSuffix) || /[-x×]/i.test(kgSuffix.replace(/%/g,''));
+    } else skipKg = true;
+  }
+  weekKeys.forEach((wk, i) => {
+    if (i === 0) {
+      ex[wk] = {
+        s: base.s != null ? base.s : baseS,
+        r: base.r != null ? base.r : baseR,
+        rest: base.rest || baseRest,
+        rpe: base.rpe != null ? String(base.rpe) : String(baseRpe),
+        kg: base.kg || ''
+      };
+      return;
+    }
+    const phase = (phasesMap[wk] || '').toLowerCase();
+    const isDeload = phase.includes('deload');
+    let s = base.s != null ? base.s : baseS;
+    let r = base.r != null ? base.r : baseR;
+    let rest = base.rest || baseRest;
+    let rpe = baseRpe;
+    let kg = base.kg || '';
+    if (isDeload) {
+      rpe = Math.max(5, baseRpe - 2);
+      s = Math.max(1, Math.round((parseInt(s) || 3) * 0.6));
+      if (baseKgNum != null && !skipKg) kg = (Math.round(baseKgNum * 0.7 * 10) / 10) + kgSuffix;
+    } else {
+      switch (progressionType) {
+        case 'dup':
+          rpe = Math.min(9, baseRpe + Math.floor(i / 3));
+          if (baseKgNum != null && !skipKg) kg = (Math.round((baseKgNum + 1.25 * i) * 10) / 10) + kgSuffix;
+          break;
+        case 'wave':
+          rpe = (i % 2 === 0) ? Math.min(8, baseRpe) : Math.min(9, baseRpe + 1);
+          if (baseKgNum != null && !skipKg) kg = (Math.round((baseKgNum + (i % 2 === 0 ? 0 : 2.5)) * 10) / 10) + kgSuffix;
+          break;
+        case 'block':
+          if (i < weekKeys.length * 0.4) rpe = Math.min(7, baseRpe);
+          else if (i < weekKeys.length * 0.8) rpe = Math.min(9, baseRpe + 2);
+          else rpe = Math.min(10, baseRpe + 3);
+          if (baseKgNum != null && !skipKg) kg = (Math.round((baseKgNum + 2 * i) * 10) / 10) + kgSuffix;
+          break;
+        case 'double':
+          rpe = Math.min(9, baseRpe + Math.floor(i / 2));
+          if (baseKgNum != null && !skipKg) kg = (Math.round((baseKgNum + 2 * Math.floor(i / 2)) * 10) / 10) + kgSuffix;
+          break;
+        default:
+          rpe = Math.min(9, baseRpe + Math.floor(i / 2));
+          if (baseKgNum != null && !skipKg) kg = (Math.round((baseKgNum + 2.5 * i) * 10) / 10) + kgSuffix;
+      }
+    }
+    ex[wk] = {s, r, rest, rpe: String(rpe), kg};
+  });
+}
