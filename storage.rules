rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Same rule as firestore.rules trainer(): uploads need an administrator-granted
    // trainerRoles/{uid} record, not just any signed-in (self-registered) account.
    function hasTrainerRole() {
      let path = /databases/(default)/documents/trainerRoles/$(request.auth.uid);
      return request.auth != null && firestore.exists(path)
        && firestore.get(path).data.uid == request.auth.uid
        && firestore.get(path).data.role == 'trainer'
        && firestore.get(path).data.enabled == true;
    }
    // Immutable, content-addressed imports.  Clients may read only through the
    // download URL; writes are limited to the signed-in trainer and media types.
    match /exercise-media/{userId}/{batchId}/{fileName} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId && hasTrainerRole()
        && request.resource.size < 80 * 1024 * 1024
        && request.resource.contentType.matches('^(image/(gif|webp|jpeg|png)|video/(mp4|webm))$');
      allow update, delete: if false;
    }
    // Compatibility for the already-published application. Remove only after
    // its clients have moved to exercise-media/.
    match /exercise-gifs/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId && hasTrainerRole()
        && request.resource.size < 80 * 1024 * 1024
        && request.resource.contentType.matches('^(image/(gif|webp|jpeg|png)|video/(mp4|webm))$');
    }
  }
}
