rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Immutable, content-addressed imports.  Clients may read only through the
    // download URL; writes are limited to the signed-in trainer and media types.
    match /exercise-media/{userId}/{batchId}/{fileName} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 80 * 1024 * 1024
        && request.resource.contentType.matches('^(image/(gif|webp|jpeg|png)|video/(mp4|webm))$');
      allow update, delete: if false;
    }
    // Compatibility for the already-published application. Remove only after
    // its clients have moved to exercise-media/.
    match /exercise-gifs/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 80 * 1024 * 1024
        && request.resource.contentType.matches('^(image/(gif|webp|jpeg|png)|video/(mp4|webm))$');
    }
  }
}
